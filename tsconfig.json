{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },

  "include": [
    "src/**/*.ts"
, "src/old/drizzle.ts.old"  ],

  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}